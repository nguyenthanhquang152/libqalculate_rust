# Feature 1 & 2: Basic Arithmetic & Number Types
(1/3) * (3 + 3i)
	1 + i

0.125 ^ -2
	64

# Feature 1 & 3: Basic Arithmetic & Intervals & Uncertainty
(2+/-0.1) * (3+/-0.2) - 1
	5.00±0.50

[2, 5] + [1, 3] * 2
	[4  11]

# Feature 1 & 4: Basic Arithmetic & Built-in Functions
sqrt(16) * 3 + sin(pi/2)
	13

2^3 * ln(e)
	8

# Feature 1 & 5: Basic Arithmetic & Variables & Custom Definitions
x_var := 4
	4

x_var * (x_var + 2) ^ 2
	144

# Feature 1 & 6: Basic Arithmetic & Units & Conversions
(5 m + 200 cm) * 3
	21 m

100 m / (10 s * 2)
	5 m/s

# Feature 1 & 7: Basic Arithmetic & Percentages
(100 - 20%) * 5
	400

50 * 10% / 2
	2.5

# Feature 2 & 3: Number Types & Intervals & Uncertainty
(3 + 4i) + (1+/-0.5)
	4.00±0.50 + 4i

[0.5, 1.5] * (1/3)
	[0.1666666667  0.5]

# Feature 2 & 4: Number Types & Built-in Functions
sqrt(1/4)
	0.5

sin(2 + 3i)
	9.154499147 - 4.168906960i

# Feature 2 & 5: Number Types & Variables & Custom Definitions
z_complex := 2 + 3i
	2 + 3i

z_complex * 2
	4 + 6i

frac_var := 3/4
	0.75

frac_var + 0.25
	1

# Feature 2 & 6: Number Types & Units & Conversions
1/4 m to cm
	25 cm

1.5 A * 2 ohm
	3 V

# Feature 2 & 7: Number Types & Percentages
(3 + 4i) * 50%
	1.5 + 2i

0.125 + 10%
	0.1375

# Feature 3 & 4: Intervals & Uncertainty & Built-in Functions
sqrt([4, 9])
	[2  3]

abs(-5+/-0.2)
	5.00±0.20

# Feature 3 & 5: Intervals & Uncertainty & Variables & Custom Definitions
interval_var := [2, 5]
	[2  5]

interval_var + 3
	[5  8]

unc_var := 10+/-0.5
	10.00±0.50

unc_var * 2
	20.0±1.0

# Feature 3 & 6: Intervals & Uncertainty & Units & Conversions
(5+/-0.2) m to cm
	500±20 cm

[1, 3] kg + [2, 4] kg
	[(3 kg)  (7 kg)]

# Feature 3 & 7: Intervals & Uncertainty & Percentages
[100, 200] + 10%
	[110  220]

(5+/-0.2) * 20%
	1.000±0.040

# Feature 4 & 5: Built-in Functions & Variables & Custom Definitions
theta := pi / 4
	0.7853981634

sin(theta)
	0.7071067812

# Feature 4 & 6: Built-in Functions & Units & Conversions
sin(30 deg)
	0.5

sqrt(16 m^2)
	4 m

# Feature 4 & 7: Built-in Functions & Percentages
sin(50%)
	0.4794255386

sqrt(25%)
	0.5

# Feature 5 & 6: Variables & Custom Definitions & Units & Conversions
distance_var := 10 m
	10 m

distance_var to cm
	1000 cm

# Feature 5 & 7: Variables & Custom Definitions & Percentages
rate_var := 15%
	0.15

200 * rate_var
	30

# Feature 6 & 7: Units & Conversions & Percentages
50 m + 10%
	55 m

(100 km/h) * 20%
	20 km/h
