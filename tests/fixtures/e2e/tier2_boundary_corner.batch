	10

myvar
	10

MyVar
	10

x := x + 1
	x + 1

x
	x + 1

y := z
	z

z := y
	z

y
	z

# Feature 6: Units & Conversions
-274 oC to K
	-0.85 K

1 m to kg
	1 m

0 m to cm
	0 cm

0 oC to K
	273.15 K

0 K to oC
	-273.15 oC

# Feature 7: Percentages
100 + 1000000%
	1000100

