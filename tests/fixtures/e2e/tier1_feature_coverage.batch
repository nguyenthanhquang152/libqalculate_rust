# Feature 1: Basic Arithmetic & Operators
1 + 1
	2

5 - 3
	2

4 * 3
	12

12 / 4
	3

2 ^ 3
	8

(1 + 2) * 4
	12

3(4 + 2)
	18

10 % 3
	1

# Feature 2: Number Types
123456789
	123456789

0.125
	0.125

1/8
	0.125

3 + 4i
	3 + 4i

(1 + 2i) * (3 - i)
	5 + 5i

# Feature 3: Intervals & Uncertainty
5+/-0.2
	5.00±0.20

5+/-0.2 + 3+/-0.1
	8.00±0.22

(5+/-0.2) * (3+/-0.1)
	15.00±0.78

[2, 5] + [1, 3]
	[3  8]

[2, 5] * 2
	[4  10]

# Feature 4: Built-in Functions
sin(pi / 2)
	1

cos(pi)
	-1

sqrt(16)
	4

ln(e)
	1

log10(100)
	2

log(8, 2)
	3

# Feature 5: Variables & Custom Definitions
pi
	3.141592654

e
	2.718281828

alpha := 5
	5

alpha
	5

alpha + 3
	8

# Feature 6: Units & Conversions
5 m to cm
	500 cm

20 miles / 2h to km/h
	16.09344 km/h

50 ohm * 2 A
	100 V

50 ohm * 2 A to base
	100 kg*m^2/(A*s^3)

5 m/s to s/m
	0.2 s/m

# Feature 7: Percentages
100 + 10%
	110

100 - 10%
	90

10% + 5%
	0.15

100 * 10%
	10

10% to fraction
	1/10
